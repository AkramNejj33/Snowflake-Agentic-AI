# ============================================================
# Snowflake Configuration
# ============================================================
SNOWFLAKE_ACCOUNT=your_account_identifier        # ex: abc12345.us-east-1
SNOWFLAKE_USER=your_username
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_DATABASE=AGENTIC_DB
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_WAREHOUSE=AGENTIC_WH
SNOWFLAKE_ROLE=AGENTIC_ROLE

# ============================================================
# Google Gemini
# ============================================================
GOOGLE_API_KEY=AIzaSy...          # console.cloud.google.com → API & Services → Credentials
GEMINI_MODEL=gemini-2.0-flash     # ou gemini-1.5-flash

# ============================================================
# Application
# ============================================================
APP_ENV=development                              # development | production
LOG_LEVEL=INFO
API_PORT=8000
UI_PORT=8501

# ============================================================
# Memory (ChromaDB)
# ============================================================
CHROMA_PERSIST_DIR=./data/chroma
AGENT_STATE_DIR=./data/agent_states
